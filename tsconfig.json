{
  "compilerOptions": {
    "lib": ["es2020", "dom", "scripthost"],
    "typeRoots": ["./node_modules/@types"],
    "types": ["mocha"],
    "stripInternal": true,
    "noUnusedLocals": true,
    "strict": true,
    "target": "es2020",
    "module": "es2020",
    "newLine": "lf",
    "moduleResolution": "bundler"
  },
  "include": ["src/*/*.ts", "test/*.ts"]
}
